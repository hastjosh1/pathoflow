          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    var mobileNumber by remember { mutableStateOf(\"\") }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    var email by remember { mutableStateOf(\"\") }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    var address by remember { mutableStateOf(\"\") }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    var collectionType by remember { mutableStateOf(\"Home Collection\") }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    var collectionStatus by remember { mutableStateOf(\"Sample Collected\") }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    var paymentStatus by remember { mutableStateOf(\"Pending\") }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
