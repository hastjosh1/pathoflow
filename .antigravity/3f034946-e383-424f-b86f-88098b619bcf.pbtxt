        lines {
          text: "// Global WhatsApp intent execution"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "fun openWhatsAppWithPatient(context: Context, patient: PatientEntry, viewModel: LabViewModel) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    try {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        // Build readable layout copy"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val listTestsNames = viewModel.allTests.value.filter { test ->"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            patient.selectedTestIdsJson.contains(test.id.toString())"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        }.map { it.name }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val bodyContent = viewModel.formatWhatsAppMessage(patient, listTestsNames)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val encodedMsg = java.net.URLEncoder.encode(bodyContent, \"UTF-8\")"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        // WhatsApp numbers"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val numbersList = viewModel.settingsState.value.labWhatsAppNumbersString.split(\",\")"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val targetNum = numbersList.firstOrNull()?.trim() ?: \"919876543210\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        // Intent"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val sendUri = \"https://api.whatsapp.com/send?phone=$targetNum&text=$encodedMsg\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val intent = Intent(Intent.ACTION_VIEW).apply {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
