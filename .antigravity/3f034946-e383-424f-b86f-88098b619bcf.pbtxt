        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    // Calculate dynamic balance automatically"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    val balanceAmount = remember(totalEstimate, amountPaidInput, paymentStatus) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val paid = amountPaidInput.toDoubleOrNull() ?: 0.0"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
