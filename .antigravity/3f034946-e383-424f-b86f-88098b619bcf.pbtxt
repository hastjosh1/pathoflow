          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "fun DashboardScreen(viewModel: LabViewModel) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    val activeLang by viewModel.activeLanguage.collectAsState()"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    val user by viewModel.currentUser.collectAsState()"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
