          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        if (originalPatientIdToDuplicateOrEdit != null) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            val patient = viewModel.getPatientById(originalPatientIdToDuplicateOrEdit)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
