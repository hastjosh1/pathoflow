          text: "    val patients by viewModel.allPatients.collectAsState()"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    // Compute Daily Metrics"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    val todayDateStr = SimpleDateFormat(\"dd-MM-yyyy\", Locale.getDefault()).format(Date())"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    val todayPatients = patients.filter { it.dateString.startsWith(todayDateStr) }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    val todayRevenue = todayPatients.sumOf { it.amountPayable }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    val pendingPayments = patients.filter { it.paymentStatus == \"Pending\" || it.paymentStatus == \"Partial\" }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    val pendingCount = pendingPayments.size"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
