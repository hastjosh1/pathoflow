        lines {
          text: "                        Text(\"Phlebotomists can only search tests. Enter Admin Security PIN to Edit/Manage prices.\", textAlign = TextAlign.Center, fontSize = 11.sp, color = MaterialTheme.colorScheme.onSurfaceVariant, modifier = Modifier.padding(top = 4.dp, bottom = 16.dp))"
