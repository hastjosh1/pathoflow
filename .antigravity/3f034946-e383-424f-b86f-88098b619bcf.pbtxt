          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    LaunchedEffect(paymentStatus, totalEstimate) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
