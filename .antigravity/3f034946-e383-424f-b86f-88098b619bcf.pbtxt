          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    LaunchedEffect(originalPatientIdToDuplicateOrEdit) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        if (originalPatientIdToDuplicateOrEdit != null) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
